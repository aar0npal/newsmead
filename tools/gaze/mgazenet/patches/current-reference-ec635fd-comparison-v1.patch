index 0000000000000000000000000000000000000000..b114475905137b1f2ff35abe11143fa922cf0901
--- /dev/null
+++ b/app/src/androidTest/java/com/newsmead/gaze/CurrentComparisonIntegrationTest.kt
@@ -0,0 +1,73 @@
+package com.newsmead.gaze
+
+import android.content.Intent
+import android.os.Build
+import android.view.WindowManager
+import androidx.test.core.app.ActivityScenario
+import androidx.test.platform.app.InstrumentationRegistry
+import com.newsmead.activities.GazeCalibrationActivity
+import com.newsmead.activities.ReadingValidationActivity
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class CurrentComparisonIntegrationTest {
+    @Test
+    fun comparisonSetupRequiresExactInputsAndStaysCameraOffAndMutationFree() {
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        fun snapshot(): Map<String, String> =
+            listOf(context.filesDir, context.noBackupFilesDir).flatMap { root ->
+                root.walkTopDown().filter { file ->
+                    file.isFile &&
+                        (file.path.contains("comparison-v1") || file.name.startsWith("calibration"))
+                }.map { it.path to ComparisonProtocol.sha256(it.readBytes()) }.toList()
+            }.toMap()
+        val slot = when (Build.MODEL) {
+            "SM-A566B" -> "a56_current_A" to "A"
+            "SM-G991B" -> "g991b_current_B" to "B"
+            else -> throw AssertionError("Comparison setup test requires one of the two frozen phone models")
+        }
+        fun comparisonIntent(activity: Class<*>): Intent = Intent(context, activity).apply {
+            putExtra(ComparisonProtocol.EXTRA_PROTOCOL_ID, ComparisonProtocol.PROTOCOL_ID)
+            putExtra(ComparisonProtocol.EXTRA_SLOT_ID, slot.first)
+            putExtra(ComparisonProtocol.EXTRA_ORDER_VARIANT, slot.second)
+        }
+
+        val before = snapshot()
+        ActivityScenario.launch<GazeCalibrationActivity>(
+            comparisonIntent(GazeCalibrationActivity::class.java),
+        ).use { scenario ->
+            scenario.onActivity {
+                assertEquals(
+                    0,
+                    it.window.attributes.flags and WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON,
+                )
+                assertFalse(it.findViewById<android.view.View>(com.newsmead.R.id.root).keepScreenOn)
+                assertTrue(it.findViewById<android.view.View>(com.newsmead.R.id.startButton).isEnabled)
+            }
+        }
+        ActivityScenario.launch<ReadingValidationActivity>(
+            comparisonIntent(ReadingValidationActivity::class.java),
+        ).use { scenario ->
+            scenario.onActivity {
+                assertEquals(
+                    0,
+                    it.window.attributes.flags and WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON,
+                )
+                assertTrue(
+                    it.findViewById<android.view.View>(com.newsmead.R.id.btnValidationAction).isEnabled,
+                )
+            }
+        }
+        val incomplete = Intent(context, GazeCalibrationActivity::class.java).apply {
+            putExtra(ComparisonProtocol.EXTRA_PROTOCOL_ID, ComparisonProtocol.PROTOCOL_ID)
+        }
+        ActivityScenario.launch<GazeCalibrationActivity>(incomplete).use { scenario ->
+            scenario.onActivity {
+                assertFalse(it.findViewById<android.view.View>(com.newsmead.R.id.startButton).isEnabled)
+            }
+        }
+        assertEquals(before, snapshot())
+    }
+}
