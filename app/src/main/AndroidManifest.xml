<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:name=".data.NewsMeadApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NewsMead"
        tools:targetApi="31">
        <activity
            android:name=".activities.SplashActivity"
            android:theme="@style/Theme.App.SplashScreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.AccountActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ArticleActivity"
            android:exported="false" />
        <activity
            android:name=".activities.MainActivity"
            android:exported="false">
        </activity>
        <!-- exported=true so the researcher can launch it via `adb shell am start`
             (Android 16 / One UI blocks adb from starting non-exported activities).
             Harmless for a research instrument; no sensitive data behind it. -->
        <activity
            android:name=".activities.GazeCalibrationActivity"
            android:exported="true" />
        <activity
            android:name=".activities.GazeTestActivity"
            android:exported="true" />
        <activity
            android:name=".activities.ReadingValidationActivity"
            android:exported="true" />
        <activity android:name=".activities.ReadingBaselineActivity" android:exported="false" />
        <!-- Researcher-only candidate throughput preview. It cannot emit gaze or write calibration. -->
        <activity
            android:name=".activities.HybridEyePerformanceActivity"
            android:exported="true" />
        <!-- Researcher-only raw horizontal gate; no mapper, gaze output, or calibration access. -->
        <activity
            android:name=".activities.CompactFaceHorizontalGateActivity"
            android:exported="true" />
        <!-- Standalone compact-candidate fit/held-out gate; never saves app calibration. -->
        <activity
            android:name=".activities.CompactFaceCalibrationGateActivity"
            android:exported="true" />

        <!-- Stages research session logs for an explicit, user-initiated share. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.research.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/research_file_paths" />
        </provider>

        <!--
          Firebase Analytics is used for product events (see logging/Analytics.kt).
          Advertising-ID collection is off: this app is also run as a study
          instrument, and an advertising identifier is not something
          participants consent to.
        -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
    </application>

</manifest>
